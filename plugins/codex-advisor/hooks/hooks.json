{
  "hooks": {
    "SessionStart": [{
      "hooks": [{
        "type": "command",
        "command": "sh \"$PLUGIN_ROOT/scripts/run-python.sh\" \"$PLUGIN_ROOT/scripts/advisor-hooks.py\"",
        "commandWindows": "sh \"$env:PLUGIN_ROOT/scripts/run-python.sh\" \"$env:PLUGIN_ROOT/scripts/advisor-hooks.py\"",
        "timeout": 10,
        "additionalContextLimit": 12000
      }]
    }],
    "PreToolUse": [{
      "matcher": "^(collaborationspawn_agent|collaborationfollowup_task|collaborationsend_message)$",
      "hooks": [{
        "type": "command",
        "command": "sh \"$PLUGIN_ROOT/scripts/run-python.sh\" \"$PLUGIN_ROOT/scripts/advisor-hooks.py\"",
        "commandWindows": "sh \"$env:PLUGIN_ROOT/scripts/run-python.sh\" \"$env:PLUGIN_ROOT/scripts/advisor-hooks.py\"",
        "timeout": 10,
        "additionalContextLimit": 4000
      }]
    }],
    "PostToolUse": [{
      "matcher": "collaborationspawn_agent",
      "hooks": [{
        "type": "command",
        "command": "sh \"$PLUGIN_ROOT/scripts/run-python.sh\" \"$PLUGIN_ROOT/scripts/advisor-hooks.py\"",
        "commandWindows": "sh \"$env:PLUGIN_ROOT/scripts/run-python.sh\" \"$env:PLUGIN_ROOT/scripts/advisor-hooks.py\"",
        "timeout": 10,
        "additionalContextLimit": 4000
      }]
    }]
  }
}
